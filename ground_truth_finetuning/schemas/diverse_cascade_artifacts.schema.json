{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "personaplex.diverse-synthesis-cascade-artifacts.v1",
  "title": "Diverse controlled synthesis cascade artifacts",
  "description": "Schemas for planning-only artifacts. Canonical response text and target audio are intentionally absent.",
  "$defs": {
    "stringList": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "topicCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "topicId", "seedRevision", "domain", "interactionModes", "registerRange", "safeStakes", "forbiddenPatterns", "diversityTags"],
      "properties": {
        "schema": {"const": "personaplex.topic-card.v1"},
        "topicId": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,119}$"},
        "seedRevision": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "domain": {"type": "string", "minLength": 3},
        "interactionModes": {"$ref": "#/$defs/stringList"},
        "registerRange": {"$ref": "#/$defs/stringList"},
        "safeStakes": {"$ref": "#/$defs/stringList"},
        "forbiddenPatterns": {"$ref": "#/$defs/stringList"},
        "diversityTags": {"$ref": "#/$defs/stringList"}
      }
    },
    "scenarioContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "scenarioId", "topicId", "mode", "premise", "participants", "startingState", "interactionOpportunity", "allowedToolClasses", "disallowedClaims", "scenarioOutcomeSpace", "requiredControlPhenomena"],
      "properties": {
        "schema": {"const": "personaplex.scenario-contract.v1"},
        "scenarioId": {"type": "string", "pattern": "^[a-z][a-z0-9_:-]{2,159}$"},
        "topicId": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,119}$"},
        "mode": {"type": "string", "minLength": 3},
        "premise": {"type": "string", "minLength": 12},
        "participants": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["role", "knowledge"], "properties": {"role": {"type": "string"}, "knowledge": {"type": "string"}}}},
        "startingState": {"type": "object", "additionalProperties": false, "required": ["knownFacts", "uncertainty", "policyConstraints"], "properties": {"knownFacts": {"$ref": "#/$defs/stringList"}, "uncertainty": {"$ref": "#/$defs/stringList"}, "policyConstraints": {"$ref": "#/$defs/stringList"}}},
        "interactionOpportunity": {"$ref": "#/$defs/stringList"},
        "allowedToolClasses": {"$ref": "#/$defs/stringList"},
        "disallowedClaims": {"$ref": "#/$defs/stringList"},
        "scenarioOutcomeSpace": {"$ref": "#/$defs/stringList"},
        "requiredControlPhenomena": {"$ref": "#/$defs/stringList"}
      }
    },
    "trajectorySeed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "trajectoryId", "scenarioId", "conversationLength", "pace", "openingStyle", "closingStyle", "voicePairPolicy", "interactionArc", "duplexEvents", "postureArc", "counterfactualPivotOrdinal", "controlPhenomena"],
      "properties": {
        "schema": {"const": "personaplex.trajectory-seed.v1"},
        "trajectoryId": {"type": "string", "pattern": "^[a-z][a-z0-9_:-]{2,199}$"},
        "scenarioId": {"type": "string", "pattern": "^[a-z][a-z0-9_:-]{2,159}$"},
        "conversationLength": {"type": "object", "additionalProperties": false, "required": ["targetTurns", "min", "max"], "properties": {"targetTurns": {"type": "integer", "minimum": 4, "maximum": 48}, "min": {"type": "integer", "minimum": 2, "maximum": 48}, "max": {"type": "integer", "minimum": 4, "maximum": 48}}},
        "pace": {"type": "string", "minLength": 3},
        "openingStyle": {"type": "string", "minLength": 3},
        "closingStyle": {"type": "string", "minLength": 3},
        "voicePairPolicy": {"const": "distinct_approved_references"},
        "interactionArc": {"$ref": "#/$defs/stringList"},
        "duplexEvents": {"type": "array", "items": {"type": "object"}},
        "postureArc": {"$ref": "#/$defs/stringList"},
        "counterfactualPivotOrdinal": {"type": "integer", "minimum": 1, "maximum": 47},
        "controlPhenomena": {"$ref": "#/$defs/stringList"},
        "semanticStateArc": {"type": "array", "items": {"type": "object"}},
        "controlRevisionSchedule": {"type": "array", "items": {"type": "object"}},
        "terminationContract": {"type": "object"},
        "negativeControlCoverage": {"$ref": "#/$defs/stringList"},
        "causalAxis": {"type": "string", "minLength": 1}
      }
    },
    "pairSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "groupId", "trajectoryId", "pivotOrdinal", "commonContextHash", "branches"],
      "properties": {
        "schema": {"const": "personaplex.counterfactual-pair-spec.v1"},
        "groupId": {"type": "string", "minLength": 8, "maxLength": 240},
        "trajectoryId": {"type": "string", "minLength": 3, "maxLength": 200},
        "pivotOrdinal": {"type": "integer", "minimum": 1, "maximum": 47},
        "commonContextHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "sharedPrefixPolicy": {"const": "native_code_identical_through_pivot"},
        "branches": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["branchId", "controlDelta", "evidenceUpdate"], "properties": {"branchId": {"enum": ["available", "constrained"]}, "controlDelta": {"type": "object", "additionalProperties": false, "required": ["field", "from", "to"], "properties": {"field": {"type": "string"}, "from": {}, "to": {}}}, "evidenceUpdate": {"type": "object"}, "availabilityTiming": {"type": "object"}, "negativeControls": {"$ref": "#/$defs/stringList"}, "semanticAssertions": {"$ref": "#/$defs/stringList"}}}}
      }
    }
  }
}
