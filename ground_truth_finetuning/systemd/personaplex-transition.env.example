# Portable template only. Installed runtime files use absolute paths and must
# not contain shell interpolation. Keep HF_TOKEN in a separate mode-0600 file.
VOXRN_RESOURCE_ROOT=/srv/voxrn_cache
# Interpreter used by preparation, training, and publication. It must provide
# CUDA-enabled torch, sentencepiece==0.2, and huggingface_hub.
PERSONAPLEX_PYTHON=/path/to/personaplex-native/bin/python
PERSONAPLEX_SYNTHESIS_ROOT=/srv/voxrn_cache/personaplex-lanes
PERSONAPLEX_CORPUS_NAMESPACE=p1000v5
# Comma-separated approved filename patterns. Keep this explicit so historical
# or unrelated certified datasets cannot enter the immutable training snapshot.
PERSONAPLEX_CERTIFIED_ARTIFACT_PATTERNS=personaplex-v7-paired-v8cf-p1000v5-*.certified.jsonl,personaplex-v7-paired-v9surpluscf-p1000v4-*.certified.jsonl
PERSONAPLEX_TARGET_CONVERSATIONS=1000
PERSONAPLEX_TRANSITION_ROOT=/srv/voxrn_cache/personaplex-transition
PERSONAPLEX_TRANSITION_STATE=/srv/voxrn_cache/personaplex-transition/v7-p1000.state.json
PERSONAPLEX_MODEL_CONTRACT=/srv/personaplex_workspace/ground_truth_runs/v4-pair-0023-certified-20260716-0618-native/native-model-contract.v4.mimi-bound.json
PERSONAPLEX_MOSHI_SOURCE_ROOT=/srv/voxrn_cache/personaplex/source/moshi
PERSONAPLEX_MOSHI_PATH=/srv/voxrn_cache/personaplex/models/distilled/student_best.pt
# Set to the codec artifact whose SHA-256 is bound by PERSONAPLEX_MODEL_CONTRACT.
PERSONAPLEX_MIMI_PATH=/srv/voxrn_cache/personaplex/models/auxiliary/tokenizer-e351c8d8-checkpoint125.safetensors
PERSONAPLEX_TOKENIZER_PATH=/srv/voxrn_cache/personaplex/models/auxiliary/tokenizer_spm_32k_3.model
PERSONAPLEX_ALLOWED_GPUS=0,1,2
# Start with one proven rank. Scale only after a measured distributed checkpoint
# on the target host verifies that every rank loads and synchronizes correctly.
PERSONAPLEX_TRAIN_MAX_WORLD_SIZE=1
# Never launch below this many admitted ranks.
PERSONAPLEX_TRAIN_MIN_WORLD_SIZE=1
# The free budget derives from the inspected model file size multiplied by this
# calibrated runtime factor; it is not a host-memory constant. The per-GPU
# reserve remains a fraction of each discovered GPU's own total memory.
PERSONAPLEX_TRAIN_MODEL_HEADROOM_RATIO=1.50
PERSONAPLEX_TRAIN_GPU_RESERVE_RATIO=0.10
# Shared-host compute ceiling. VRAM admission remains model-derived and is the
# hard safety gate; this preserves a small live-service compute margin.
PERSONAPLEX_TRAIN_MAX_GPU_UTILIZATION_PCT=85
# Disable Moshi's lazy torch.compile worker pool for adapter training. Set 0
# only after a measured, bounded compilation benchmark on the target host.
PERSONAPLEX_TRAIN_DISABLE_TORCH_COMPILE=1
PERSONAPLEX_HF_DATASET_REPO=cudabenchmarktest/personaplex-v7-semantic-control-synthetic
PERSONAPLEX_HF_PRIVATE=1
