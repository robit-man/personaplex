[Unit]
Description=PersonaPlex synthetic-data resource budget

[Slice]
# Generation reads /proc/meminfo before every group and applies the
# authoritative host-wide 80%/75% pause-resume policy, including other
# services. These systemd limits are percentages of discovered physical RAM,
# so the slice remains a later safety net on any host without fixed byte caps.
MemoryHigh=85%
MemoryMax=90%
MemorySwapMax=0
