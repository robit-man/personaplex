WorkingDirectory=/home/roko/Documents/Projects/github_repos/vox_docker_eval/voryn
ExecStart=/srv/personaplex_workspace/robit-man-personaplex/ground_truth_finetuning/tools/run-v7-voicebox-worker-service.sh %i
