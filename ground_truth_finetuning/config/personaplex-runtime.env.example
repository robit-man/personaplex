# Copy to /srv/voxrn_cache/personaplex-systemd/personaplex-runtime.env.
# This is the sole source of PersonaPlex endpoint and GPU routing truth.
PERSONAPLEX_RUNTIME_VERSION=2
PERSONAPLEX_BIND_HOST=127.0.0.1
PERSONAPLEX_CONTROL_PORT=12083
PERSONAPLEX_CHATML_PORT=12084
PERSONAPLEX_CONTROL_LANE0_PORT=12085
PERSONAPLEX_CHATML_LANE0_PORT=12086
PERSONAPLEX_CONTROL_LANE1_PORT=12083
PERSONAPLEX_CHATML_LANE1_PORT=12084
PERSONAPLEX_CONTROL_LANE2_PORT=12087
PERSONAPLEX_CHATML_LANE2_PORT=12088
PERSONAPLEX_VOICEBOX_PORT=17502
PERSONAPLEX_CONTROL_MODEL=robit/ornith:35b
PERSONAPLEX_CONTROL_MODELS=robit/ornith:35b,robit/ornith-vision:35b,open-agents-qwen36-35b:latest,huihui_ai/Qwen3.6-abliterated:27b,nemotron-3-nano:30b,gemma3:27b
# Remote whole-generative-stack binding. Set the key only in the deployed env.
OPENROUTER_API_KEY=
PERSONAPLEX_CASCADE_PLANNER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
PERSONAPLEX_CASCADE_PLANNER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
PERSONAPLEX_TAXONOMY_REPAIR_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
PERSONAPLEX_TAXONOMY_REPAIR_MODEL=nvidia/nemotron-3-super-120b-a12b:free
PERSONAPLEX_GENERATIVE_TRANSPORT_ATTEMPTS=6
PERSONAPLEX_GENERATIVE_RETRY_BASE_SECONDS=1
PERSONAPLEX_GENERATIVE_RETRY_MAX_SECONDS=30
# Physical local route for the logical Super binding. Per-call artifacts record
# both identities; keeping the logical binding stable permits exact checkpoint resume.
PERSONAPLEX_LOCAL_SUPER_ENDPOINT=http://127.0.0.1:11434/v1/chat/completions
PERSONAPLEX_LOCAL_SUPER_MODEL=nemotron-3-super:120b
PERSONAPLEX_LOCAL_SUPER_PREFER=1
# Independent local Nemotron proposer used when the logical Ultra route is unavailable.
PERSONAPLEX_LOCAL_SECONDARY_ENDPOINT=http://127.0.0.1:11434/v1/chat/completions
PERSONAPLEX_LOCAL_SECONDARY_MODEL=nemotron-3-nano:30b
PERSONAPLEX_LOCAL_SECONDARY_PREFER=1
# Nemotron Super performs the primary audit; it cannot self-certify because the
# Ultra proposer and evidence-bound local verifier are independently bound.
PERSONAPLEX_BLUEPRINT_JUDGE_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
PERSONAPLEX_BLUEPRINT_JUDGE_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# The independent secondary proposer is env-only and uses OPENROUTER_API_KEY.
PERSONAPLEX_LARGE_PROPOSER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
PERSONAPLEX_LARGE_PROPOSER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
PERSONAPLEX_TAXONOMY_VERIFIER_ENDPOINT=http://127.0.0.1:12084/v1/chat/completions
PERSONAPLEX_TAXONOMY_VERIFIER_MODEL=gemma3:27b
PERSONAPLEX_TAXONOMY_VERIFIER_WORKERS=1
# Stage-E contract scrutiny follows the same Super/Ultra/evidence-bound topology.
PERSONAPLEX_SCENARIO_JUDGE_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
PERSONAPLEX_SCENARIO_JUDGE_MODEL=nvidia/nemotron-3-super-120b-a12b:free
PERSONAPLEX_SCENARIO_SECONDARY_JUDGE_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
PERSONAPLEX_SCENARIO_SECONDARY_JUDGE_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
PERSONAPLEX_SCENARIO_ADJUDICATOR_ENDPOINT=http://127.0.0.1:12084/v1/chat/completions
PERSONAPLEX_SCENARIO_ADJUDICATOR_MODEL=gemma3:27b
PERSONAPLEX_CONTROL_NUM_CTX=16384
PERSONAPLEX_CONTROL_GPU=1
PERSONAPLEX_CONTROL_LANE0_GPU=0
PERSONAPLEX_CONTROL_LANE1_GPU=1
PERSONAPLEX_CONTROL_LANE2_GPU=2
PERSONAPLEX_VOICEBOX_GPU=2
PERSONAPLEX_VOICEBOX_LANE0_PORT=17503
PERSONAPLEX_VOICEBOX_LANE1_PORT=17504
PERSONAPLEX_VOICEBOX_LANE2_PORT=17502
PERSONAPLEX_VOICEBOX_LANE0_GPU=0
PERSONAPLEX_VOICEBOX_LANE1_GPU=1
PERSONAPLEX_VOICEBOX_LANE2_GPU=2
PERSONAPLEX_SYNTHESIS_BATCH_GROUPS=8
PERSONAPLEX_SYNTHESIS_MAX_ASR_WER=0.12
PERSONAPLEX_SYNTHESIS_PLAN_PATH=/srv/personaplex_workspace/ground_truth_runs/personaplex-1000-plan.v8-counterfactual-diverse-v6.jsonl

# Kyutai MoshiRAG ARC-4 semantic reference conditioner.
# The bootstrap resolves and records the tokenizer revision; the launcher reads
# PERSONAPLEX_MOSHIRAG_TOKENIZER_RECORD when TOKENIZER_DIR is unset.
PERSONAPLEX_SHARED_CACHE_ROOT=/srv/voxrn_cache
PERSONAPLEX_MOSHIRAG_SOURCE_ROOT=/srv/voxrn_cache/personaplex/source/moshi-rag-official
PERSONAPLEX_MOSHIRAG_RAG_DIR=/srv/voxrn_cache/huggingface/kyutai/moshika-rag-pytorch-bf16/7135a6e3c46abb66c2cd95cb04cbfcbe8376f83d
PERSONAPLEX_MOSHIRAG_ARC_DIR=/srv/voxrn_cache/huggingface/kyutai/ARC4_Encoder_Llama/f27d986b193bfdff742d54412d3057b498ec8cc9
PERSONAPLEX_MOSHIRAG_TOKENIZER_RECORD=/srv/voxrn_cache/personaplex/imports/moshirag-tokenizer.json
PERSONAPLEX_MOSHIRAG_CONDITIONER_VENV=/srv/voxrn_cache/personaplex/venvs/moshirag-conditioner
PERSONAPLEX_MOSHIRAG_CONDITIONER_HOST=127.0.0.1
PERSONAPLEX_MOSHIRAG_CONDITIONER_PORT=12089
PERSONAPLEX_MOSHIRAG_CONDITIONER_GPU=1
PERSONAPLEX_MOSHIRAG_RELEASE_REVISION=8c6dfc101b7871baa428424bcdc583b74fb561d9
